# Example vhost for the HOST nginx in front of the container
# (e.g. /etc/nginx/sites-available/line-protection-sim). TLS via certbot:
#   certbot --nginx -d sim.example.com
# Basic auth (optional): htpasswd -c /etc/nginx/.htpasswd-sim trainee

server {
    listen 80;
    listen [::]:80;
    server_name sim.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name sim.example.com;

    ssl_certificate     /etc/letsencrypt/live/sim.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sim.example.com/privkey.pem;

    # Optional: gate training-client access
    # auth_basic "Line Protection Simulator";
    # auth_basic_user_file /etc/nginx/.htpasswd-sim;

    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# No-Docker alternative: serve the built files directly (app/deploy.sh
# rsyncs dist/ to /var/www/line-protection-sim), replacing the proxy location with
#   root /var/www/line-protection-sim;
#   location /assets/ { expires 1y; try_files $uri =404; }
#   location / { expires -1; try_files $uri /index.html; }
# plus the add_header lines from deploy/nginx.conf.
